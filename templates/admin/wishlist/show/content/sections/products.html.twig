{% from '@SyliusAdmin/shared/helper/product_image.html.twig' import image %}
{% import '@SyliusAdmin/shared/helper/money.html.twig' as money %}

{% set wishlist = hookable_metadata.context.wishlist %}
{% set currency_code = wishlist.channel.baseCurrency.code|default(null) %}

<div class="card mb-3" {{ sylius_test_html_attribute('wishlist-products') }}>
    <div class="card-header">
        <div class="card-title">
            {{ 'evolutive_sylius_wishlist.ui.products'|trans }}
            <span class="badge ms-1" {{ sylius_test_html_attribute('wishlist-products-total') }}>{{ wishlist.countItems }}</span>
        </div>
    </div>
    {% if wishlist.empty %}
        <div class="card-body text-secondary" {{ sylius_test_html_attribute('wishlist-empty') }}>
            {{ 'evolutive_sylius_wishlist.ui.admin_empty'|trans }}
        </div>
    {% else %}
        <div class="table-responsive">
            <table class="table table-vcenter card-table">
                <thead>
                    <tr>
                        <th class="w-1"><span class="visually-hidden">{{ 'sylius.ui.image'|trans }}</span></th>
                        <th>{{ 'sylius.ui.product'|trans }}</th>
                        <th>{{ 'sylius.ui.code'|trans }}</th>
                        <th class="text-end">{{ 'sylius.ui.price'|trans }}</th>
                        <th>{{ 'evolutive_sylius_wishlist.ui.added_at'|trans }}</th>
                    </tr>
                </thead>
                <tbody>
                    {% for item in wishlist.items %}
                        {% set variant = item.variant %}
                        {% set product = item.product %}
                        {% set channel_pricing = variant.channelPricingForChannel(wishlist.channel) %}
                        <tr {{ sylius_test_html_attribute('wishlist-item', variant.code) }}>
                            <td>
                                <div class="avatar avatar-md">
                                    {{ image(product, {class: 'rounded'}) }}
                                </div>
                            </td>
                            <td>
                                <a href="{{ path('sylius_admin_product_show', {id: product.id}) }}" class="fw-bold" {{ sylius_test_html_attribute('wishlist-item-name') }}>{{ product.name }}</a>
                                {% if not product.simple %}
                                    <div class="text-secondary">{{ include('@EvolutiveSyliusWishlistPlugin/shop/wishlist/_variant_label.html.twig', {variant}) }}</div>
                                {% endif %}
                            </td>
                            <td><span class="text-secondary">{{ variant.code }}</span></td>
                            <td class="text-end" {{ sylius_test_html_attribute('wishlist-item-price') }}>
                                {% if channel_pricing is not null and channel_pricing.price is not null and currency_code is not null %}
                                    {{ money.format(channel_pricing.price, currency_code) }}
                                {% else %}
                                    <span class="text-secondary">{{ 'evolutive_sylius_wishlist.ui.no_price'|trans }}</span>
                                {% endif %}
                            </td>
                            <td>{{ item.createdAt|date('d-m-Y H:i') }}</td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
    {% endif %}
</div>
