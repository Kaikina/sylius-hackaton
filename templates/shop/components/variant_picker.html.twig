<div {{ attributes }}>
    {% set selected = this.selectedVariant %}
    {% if selected is not null %}
        <button type="button" class="btn btn-link px-0 mb-2"
                data-action="live#action" data-live-action-param="back"
                {{ sylius_test_html_attribute('wishlist-variant-back') }}>
            &larr; {{ 'evolutive_sylius_wishlist.ui.choose_another_variant'|trans }}
        </button>
        <div class="fw-semibold mb-2">{{ include('@EvolutiveSyliusWishlistPlugin/shop/wishlist/_variant_label.html.twig', {variant: selected}) }}</div>
        {{ component('evolutive_wishlist:wishlist_picker', { product: product, variant: selected, key: 'variant-' ~ selected.id }) }}
    {% else %}
        <ul class="list-group list-group-flush">
            {% for row in this.rows %}
                {% set variant = row.variant %}
                <li class="list-group-item d-flex align-items-center gap-3 px-0" {{ sylius_test_html_attribute('wishlist-variant', variant.code) }}>
                    <div class="flex-grow-1">
                        <div class="fw-semibold">{{ include('@EvolutiveSyliusWishlistPlugin/shop/wishlist/_variant_label.html.twig', {variant}) }}</div>
                        <div class="small">
                            {{ component('sylius_shop:product:card:price', { variant: variant, template: '@SyliusShop/product/common/price.html.twig' }) }}
                            {% if not row.inStock %}
                                <span class="badge text-bg-secondary ms-2">{{ 'sylius.ui.out_of_stock'|trans }}</span>
                            {% endif %}
                        </div>
                    </div>
                    <button type="button"
                            class="btn btn-light rounded-circle p-2 lh-1"
                            aria-label="{{ 'evolutive_sylius_wishlist.ui.choose_destination'|trans }}"
                            title="{{ 'evolutive_sylius_wishlist.ui.choose_destination'|trans }}"
                            data-action="live#action"
                            data-live-action-param="select"
                            data-live-variant-id-param="{{ variant.id }}"
                            data-loading="addAttribute(disabled)"
                            {{ sylius_test_html_attribute('wishlist-variant-toggle', variant.code) }}>
                        {{ include('@EvolutiveSyliusWishlistPlugin/shop/components/_heart.html.twig', {active: row.inWishlist}) }}
                    </button>
                </li>
            {% endfor %}
        </ul>
    {% endif %}
</div>
