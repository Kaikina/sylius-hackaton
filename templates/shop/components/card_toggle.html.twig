{# Zero-height wrapper so the heart overlays the top-right corner of the tile image. #}
{% set variants = this.variants %}
<div class="position-relative" {{ attributes }}>
    {% if variants is not empty %}
        {% set active = this.inWishlist %}
        {% set label = (active ? 'evolutive_sylius_wishlist.ui.in_wishlist' : 'evolutive_sylius_wishlist.ui.add_to_wishlist')|trans %}
        <div class="position-absolute top-0 end-0 m-2" style="z-index: 2;">
            <button type="button"
                    class="btn btn-light rounded-circle p-2 lh-1 shadow-sm"
                    aria-label="{{ label }}" title="{{ label }}"
                    data-bs-toggle="modal"
                    data-bs-target="#{{ modalId }}"
                    {{ sylius_test_html_attribute('wishlist-toggle', product.code) }}>
                {{ include('@EvolutiveSyliusWishlistPlugin/shop/components/_heart.html.twig', {active}) }}
            </button>
        </div>

        {# Ignored on re-render so Bootstrap's open state survives; the pickers refresh themselves. #}
        <div class="modal fade" id="{{ modalId }}" tabindex="-1" aria-labelledby="{{ modalId }}-title" aria-hidden="true" data-live-ignore>
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title" id="{{ modalId }}-title">{{ 'evolutive_sylius_wishlist.ui.add_product_to_wishlist'|trans({'%product%': product.name}) }}</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'evolutive_sylius_wishlist.ui.close'|trans }}"></button>
                    </div>
                    <div class="modal-body">
                        {% if this.singleVariant %}
                            {{ component('evolutive_wishlist:wishlist_picker', { product: product, variant: variants|first }) }}
                        {% else %}
                            {{ component('evolutive_wishlist:variant_picker', { product: product }) }}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
</div>
