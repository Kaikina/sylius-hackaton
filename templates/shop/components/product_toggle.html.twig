<div class="mb-3" {{ attributes }}>
    {% set active = this.inWishlist %}
    {# The modal lives in a separate hook entry (product/show/wishlist_modal.html.twig). #}
    {% set modal_id = 'evolutive-wishlist-product-modal' %}
    <button type="button"
            class="btn btn-outline-secondary d-inline-flex align-items-center gap-2"
            data-bs-toggle="modal"
            data-bs-target="#{{ modal_id }}"
            {{ not this.wishlistable ? 'disabled' }}
            {{ sylius_test_html_attribute('wishlist-toggle') }}>
        {{ include('@EvolutiveSyliusWishlistPlugin/shop/components/_heart.html.twig', {active}) }}
        <span>{{ (active ? 'evolutive_sylius_wishlist.ui.in_wishlist' : 'evolutive_sylius_wishlist.ui.add_to_wishlist')|trans }}</span>
    </button>
</div>
