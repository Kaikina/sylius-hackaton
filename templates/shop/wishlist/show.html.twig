{% extends '@SyliusShop/shared/layout/base.html.twig' %}

{% block title %}{{ wishlist.name }} | {{ parent() }}{% endblock %}

{% block content %}
{% set form = evolutive_wishlist_items_form(wishlist) %}
{% form_theme form 'bootstrap_5_layout.html.twig' %}
{# Rendered inside the "Move to…" modal by the move_targets live component. #}
{% do form.targets.setRendered() %}
{% set items = wishlist.items|filter(item => item.variant is not null) %}

<div class="container my-5" {{ sylius_test_html_attribute('wishlist') }}>
    <nav class="mb-4" aria-label="{{ 'evolutive_sylius_wishlist.ui.my_wishlists'|trans }}">
        <ul class="nav nav-pills flex-wrap gap-1" {{ sylius_test_html_attribute('wishlist-nav') }}>
            {% for other in evolutive_wishlists() %}
                <li class="nav-item">
                    <a class="nav-link{{ other.id == wishlist.id ? ' active' }}"
                       {{ other.id == wishlist.id ? 'aria-current="page"' }}
                       href="{{ path('evolutive_sylius_wishlist_shop_wishlist_show', {id: other.id}) }}"
                       {{ sylius_test_html_attribute('wishlist-nav-item', other.name) }}>
                        {{ other.name }} <span class="badge text-bg-light">{{ other.countItems }}</span>
                    </a>
                </li>
            {% endfor %}
            <li class="nav-item">
                <a class="nav-link" href="{{ path('evolutive_sylius_wishlist_shop_wishlist_index') }}">{{ 'evolutive_sylius_wishlist.ui.all_wishlists'|trans }}</a>
            </li>
        </ul>
    </nav>

    <div class="d-flex flex-wrap align-items-center gap-2 mb-4">
        <h1 class="h2 mb-0 me-auto" {{ sylius_test_html_attribute('wishlist-name') }}>{{ wishlist.name }}</h1>
        <a href="{{ path('evolutive_sylius_wishlist_shop_wishlist_update', {id: wishlist.id}) }}" class="btn btn-outline-secondary" {{ sylius_test_html_attribute('wishlist-rename', wishlist.name) }}>
            {{ 'evolutive_sylius_wishlist.ui.rename'|trans }}
        </a>
        {{ include('@EvolutiveSyliusWishlistPlugin/shop/wishlist/_delete_form.html.twig', {wishlist}) }}
    </div>

    {% if items is empty %}
        <div class="text-center py-5" {{ sylius_test_html_attribute('wishlist-empty') }}>
            <p class="lead mb-4">{{ 'evolutive_sylius_wishlist.ui.empty'|trans }}</p>
            <a href="{{ path('sylius_shop_homepage') }}" class="btn btn-primary">{{ 'evolutive_sylius_wishlist.ui.continue_shopping'|trans }}</a>
        </div>
    {% else %}
        {% set route_parameters = {id: wishlist.id} %}
        {{ form_start(form, {action: path('evolutive_sylius_wishlist_shop_wishlist_items_add_to_cart', route_parameters), attr: {id: 'evolutive-wishlist-form'}}) }}
            <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                <div class="form-check me-auto">
                    <input class="form-check-input" type="checkbox" id="evolutive-wishlist-select-all"
                           onchange="this.form.querySelectorAll('[data-wishlist-item-checkbox]').forEach(c => c.checked = this.checked)">
                    <label class="form-check-label" for="evolutive-wishlist-select-all">{{ 'evolutive_sylius_wishlist.ui.select_all'|trans }}</label>
                </div>
                <button type="submit" class="btn btn-primary" {{ sylius_test_html_attribute('wishlist-add-selected') }}>
                    {{ 'evolutive_sylius_wishlist.ui.add_selected_to_cart'|trans }}
                </button>
                <button type="button" class="btn btn-outline-primary" data-bs-toggle="modal" data-bs-target="#evolutive-wishlist-move-modal" {{ sylius_test_html_attribute('wishlist-move-selected') }}>
                    {{ 'evolutive_sylius_wishlist.ui.move_to'|trans }}
                </button>
                <button type="submit" class="btn btn-outline-secondary"
                        formaction="{{ path('evolutive_sylius_wishlist_shop_wishlist_items_remove', route_parameters) }}"
                        {{ sylius_test_html_attribute('wishlist-remove-selected') }}>
                    {{ 'evolutive_sylius_wishlist.ui.remove_selected'|trans }}
                </button>
                <button type="submit" class="btn btn-outline-danger"
                        formaction="{{ path('evolutive_sylius_wishlist_shop_wishlist_clear', route_parameters) }}"
                        onclick="return confirm('{{ 'evolutive_sylius_wishlist.ui.clear_confirmation'|trans|e('js') }}')"
                        {{ sylius_test_html_attribute('wishlist-clear') }}>
                    {{ 'evolutive_sylius_wishlist.ui.clear'|trans }}
                </button>
            </div>

            <div class="table-responsive">
                <table class="table align-middle">
                    <thead>
                        <tr>
                            <th class="w-auto"><span class="visually-hidden">{{ 'evolutive_sylius_wishlist.ui.select'|trans }}</span></th>
                            <th colspan="2">{{ 'sylius.ui.product'|trans }}</th>
                            <th>{{ 'sylius.ui.price'|trans }}</th>
                            <th class="text-end"><span class="visually-hidden">{{ 'sylius.ui.actions'|trans }}</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        {% for child in form.items %}
                            {% set item = form.items.vars.choices[loop.index0].data %}
                            {% set variant = item.variant %}
                            {% set product = item.product %}
                            {% set available = evolutive_wishlist_is_available(variant) %}
                            {% set item_parameters = route_parameters|merge({item: item.id}) %}
                            <tr {{ sylius_test_html_attribute('wishlist-item', variant.code) }}>
                                <td>
                                    {{ form_widget(child, {label: false, attr: {'data-wishlist-item-checkbox': '', 'aria-label': 'evolutive_sylius_wishlist.ui.select'|trans}}) }}
                                </td>
                                <td style="width: 90px;">
                                    <a href="{{ path('sylius_shop_product_show', {slug: product.slug}) }}" class="d-block overflow-hidden bg-light rounded-3" style="aspect-ratio: 3/4;">
                                        {{ component('sylius_shop:main_image', { product: product, class: 'w-100 h-100 object-fit-cover' }) }}
                                    </a>
                                </td>
                                <td>
                                    <a href="{{ path('sylius_shop_product_show', {slug: product.slug}) }}" class="link-reset fw-semibold" {{ sylius_test_html_attribute('wishlist-item-name') }}>{{ product.name }}</a>
                                    {% if not product.simple %}
                                        <div class="small text-body-secondary">{{ include('@EvolutiveSyliusWishlistPlugin/shop/wishlist/_variant_label.html.twig', {variant}) }}</div>
                                    {% endif %}
                                    {% if not available %}
                                        <span class="badge text-bg-secondary mt-1" {{ sylius_test_html_attribute('wishlist-item-unavailable') }}>{{ 'evolutive_sylius_wishlist.ui.unavailable'|trans }}</span>
                                    {% endif %}
                                </td>
                                <td>
                                    {% if variant.channelPricingForChannel(sylius.channel) %}
                                        {{ component('sylius_shop:product:card:price', { variant: variant, template: '@SyliusShop/product/common/price.html.twig' }) }}
                                    {% endif %}
                                </td>
                                <td class="text-end text-nowrap">
                                    <button type="submit" class="btn btn-sm btn-primary"
                                            formaction="{{ path('evolutive_sylius_wishlist_shop_wishlist_items_add_to_cart', item_parameters) }}"
                                            {{ not available ? 'disabled' }}
                                            {{ sylius_test_html_attribute('wishlist-item-add-to-cart') }}>
                                        {{ 'sylius.ui.add_to_cart'|trans }}
                                    </button>
                                    <button type="submit" class="btn btn-sm btn-outline-secondary"
                                            formaction="{{ path('evolutive_sylius_wishlist_shop_wishlist_items_remove', item_parameters) }}"
                                            {{ sylius_test_html_attribute('wishlist-item-remove') }}>
                                        {{ 'evolutive_sylius_wishlist.ui.remove'|trans }}
                                    </button>
                                </td>
                            </tr>
                        {% endfor %}
                    </tbody>
                </table>
            </div>

            <div class="modal fade" id="evolutive-wishlist-move-modal" tabindex="-1" aria-labelledby="evolutive-wishlist-move-modal-title" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content">
                        <div class="modal-header">
                            <h5 class="modal-title" id="evolutive-wishlist-move-modal-title">{{ 'evolutive_sylius_wishlist.ui.move_selected_to'|trans }}</h5>
                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{ 'evolutive_sylius_wishlist.ui.close'|trans }}"></button>
                        </div>
                        <div class="modal-body">
                            {{ component('evolutive_wishlist:move_targets', { sourceId: wishlist.id }) }}
                        </div>
                        <div class="modal-footer">
                            <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">{{ 'sylius.ui.cancel'|trans }}</button>
                            <button type="submit" class="btn btn-primary"
                                    formaction="{{ path('evolutive_sylius_wishlist_shop_wishlist_items_move', route_parameters) }}"
                                    {{ sylius_test_html_attribute('wishlist-move-submit') }}>
                                {{ 'evolutive_sylius_wishlist.ui.move'|trans }}
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        {{ form_end(form) }}
    {% endif %}
</div>
{% endblock %}
